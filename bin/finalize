#!/usr/bin/env bash
# ================================================================
# npm-prebundled-nodejs_buildpack — finalize
#
# Validates the pre-bundled application structure.
# Explicitly does NOT run npm install, npm ci or npm rebuild.
# ================================================================
set -euo pipefail

BUILD_DIR="$1"
CACHE_DIR="$2"
DEPS_DIR="$3"
DEPS_IDX="$4"

BUILDPACK_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${BUILDPACK_DIR}/lib/utils.sh"

# Ensure node is on PATH from supply phase
export PATH="${DEPS_DIR}/${DEPS_IDX}/node/bin:${DEPS_DIR}/${DEPS_IDX}/bin:${PATH}"

log_info "Finalize phase starting"
log_info "Validating pre-bundled application structure..."

ERRORS=0

# ── Check 1: package.json ───────────────────────────────────────

if [ ! -f "${BUILD_DIR}/package.json" ]; then
  log_error "package.json not found"
  ERRORS=$((ERRORS + 1))
else
  APP_NAME=$(read_package_field "${BUILD_DIR}/package.json" "name")
  log_detail "App name: ${APP_NAME:-unknown}"
fi

# ── Check 2: node_modules ──────────────────────────────────────

if [ ! -d "${BUILD_DIR}/node_modules" ]; then
  log_error "node_modules/ directory not found!"
  log_error "This buildpack requires pre-bundled dependencies."
  log_error "Run 'npm ci --omit=dev' in the app directory before packaging."
  ERRORS=$((ERRORS + 1))
else
  # Hidden entries (.bin, .package-lock.json) are npm metadata, not packages
  DEP_COUNT=$(find "${BUILD_DIR}/node_modules" -maxdepth 1 -mindepth 1 \( -type d -o -type l \) ! -name '.*' | wc -l)
  log_detail "node_modules: ${DEP_COUNT} top-level packages"

  if [ "$DEP_COUNT" -lt 1 ]; then
    log_warn "node_modules exists but appears empty!"
    ERRORS=$((ERRORS + 1))
  fi

  # npm links .bin entries and workspace/file: dependencies; only links
  # without a target inside the app survive packaging as broken
  BAD_SYMLINKS=$(find_bad_symlinks "$BUILD_DIR")
  if [ -n "$BAD_SYMLINKS" ]; then
    BAD_COUNT=$(echo "$BAD_SYMLINKS" | wc -l)
    log_error "Found ${BAD_COUNT} broken symlink(s) in node_modules/:"
    # sed reads all input; head would close the pipe early and trip pipefail
    sed -n '1,20p' <<<"$BAD_SYMLINKS" | while IFS= read -r line; do log_detail "$line"; done
    [ "$BAD_COUNT" -gt 20 ] && log_detail "... and $((BAD_COUNT - 20)) more"
    log_error "Symlinks must resolve to a path inside the app directory."
    log_error "npm links file: dependencies and workspace packages to their source folder."
    log_error "For file: dependencies run 'npm ci --omit=dev --install-links';"
    log_error "for workspace packages depend on an 'npm pack' tarball instead."
    ERRORS=$((ERRORS + 1))
  fi
fi

# ── Check 3: Start command ─────────────────────────────────────

START_SCRIPT=$(read_package_field "${BUILD_DIR}/package.json" "scripts.start")

HAS_SERVER_JS=false; [ -f "${BUILD_DIR}/server.js" ] && HAS_SERVER_JS=true || true
HAS_INDEX_JS=false;  [ -f "${BUILD_DIR}/index.js" ]  && HAS_INDEX_JS=true || true

if [ -n "$START_SCRIPT" ]; then
  log_detail "Start script: ${START_SCRIPT}"
elif [ "$HAS_SERVER_JS" = true ]; then
  log_detail "No start script found; will use server.js"
elif [ "$HAS_INDEX_JS" = true ]; then
  log_detail "No start script found; will use index.js"
else
  log_warn "No start script in package.json, and no server.js or index.js found"
  log_warn "Set 'command' in your mta.yaml parameters"
fi

# ── Check 4: Smoke test — resolve first dependency ──────────────

if [ -f "${BUILD_DIR}/package.json" ]; then
  FIRST_DEP=$(read_first_dependency "${BUILD_DIR}/package.json")

  if [ -n "$FIRST_DEP" ]; then
    # Name and path go in as arguments, not spliced into the JavaScript;
    # -- stops node from reading a name like --version as its own option
    if node -e 'require.resolve(process.argv[1], { paths: [process.argv[2]] })' \
        -- "$FIRST_DEP" "${BUILD_DIR}/node_modules" 2>/dev/null; then
      log_detail "Dependency smoke test passed (resolved '${FIRST_DEP}')"
    else
      log_warn "Could not resolve '${FIRST_DEP}' — node_modules may be incomplete"
    fi
  fi
fi

# ── Final verdict ───────────────────────────────────────────────

if [ "$ERRORS" -gt 0 ]; then
  log_error "Validation failed with ${ERRORS} error(s)"
  log_error ""
  log_error "Expected workflow:"
  log_error "  1. npm ci --omit=dev (in the app directory)"
  log_error "  2. Package the app directory, including node_modules/, into your MTAR"
  log_error "  3. MTAR must contain package.json + node_modules/ (symlinks only within the app)"
  exit 1
fi

# ── Fix permissions ─────────────────────────────────────────────
# After validation, so chmod never follows a link out of the app.
# .bin entries are symlinks with npm; chmod +x applies to their targets.

log_info "Setting file permissions..."
chmod -R +r "${BUILD_DIR}/node_modules"
find "${BUILD_DIR}/node_modules/.bin" \( -type f -o -type l \) -exec chmod +x {} + 2>/dev/null || true

log_info "Validation passed — application is ready"
log_info "No npm install executed. Pre-bundled dependencies will be used as-is."
